+func TestMessageShardLookupEmptyAndFailures(t *testing.T) {
+	const tableName = "Msg_synthetic_empty_history"
+
+	t.Run("table absent after all available shards were checked", func(t *testing.T) {
+		for _, shardCount := range []int{1, 3} {
+			found, err := finishMessageShardLookup(tableName, shardCount, nil, nil)
+			if !errors.Is(err, errMessageTableAbsent) {
+				t.Fatalf("%d checked shards: error = %v, want errMessageTableAbsent", shardCount, err)
+			}
+			if len(found) != 0 {
+				t.Fatalf("absent table returned %d shards", len(found))
+			}
+		}
+	})
+
+	t.Run("no shards is not evidence of an empty chat", func(t *testing.T) {
+		found, err := finishMessageShardLookup(tableName, 0, nil, nil)
+		if err == nil || errors.Is(err, errMessageTableAbsent) {
+			t.Fatalf("no shards: error = %v, want a non-empty non-sentinel error", err)
+		}
+		if len(found) != 0 {
+			t.Fatalf("no shards returned %d results", len(found))
+		}
+	})
+
+	failureKinds := []string{"missing key", "open failure", "schema query failure"}
+	for _, failureKind := range failureKinds {
+		for _, partialFound := range []bool{false, true} {
+			t.Run(fmt.Sprintf("%s/partial_found=%t", failureKind, partialFound), func(t *testing.T) {
+				cause := errors.New("synthetic " + failureKind)
+				var input []msgShardDB
+				if partialFound {
+					// These inert handles exercise the cleanup path without opening
+					// a database or loading the native database library.
+					input = []msgShardDB{
+						{Name: "message_0.db", DB: &wcdb.DB{}},
+						{Name: "message_1.db", DB: nil},
+					}
+				}
+				found, err := finishMessageShardLookup(tableName, 3, input, []error{
+					fmt.Errorf("message_2.db: %w", cause),
+				})
+				if err == nil || errors.Is(err, errMessageTableAbsent) {
+					t.Fatalf("failed shard was treated as an empty or complete result: error = %v", err)
+				}
+				if !errors.Is(err, cause) {
+					t.Fatalf("underlying shard failure was lost: error = %v", err)
+				}
+				if found != nil {
+					t.Fatalf("failed lookup returned a non-nil partial result: %#v", found)
+				}
+			})
+		}
+	}
+
+	t.Run("multiple failures preserve the first cause and reject partial results", func(t *testing.T) {
+		first := errors.New("synthetic missing key")
+		second := errors.New("synthetic schema query failure")
+		found, err := finishMessageShardLookup(tableName, 3, []msgShardDB{
+			{Name: "message_2.db", DB: &wcdb.DB{}},
+		}, []error{
+			fmt.Errorf("message_0.db: %w", first),
+			fmt.Errorf("message_1.db: %w", second),
+		})
+		if !errors.Is(err, first) || errors.Is(err, errMessageTableAbsent) {
+			t.Fatalf("lookup error did not preserve the first failure as a non-sentinel error: %v", err)
+		}
+		if found != nil {
+			t.Fatalf("failed lookup returned a non-nil partial result: %#v", found)
+		}
+	})
+
+	t.Run("fully checked successful result is preserved", func(t *testing.T) {
+		input := []msgShardDB{
+			{Name: "message_0.db", DB: &wcdb.DB{}, Warnings: []string{"synthetic warning"}},
+			{Name: "message_2.db", DB: &wcdb.DB{}},
+		}
+		found, err := finishMessageShardLookup(tableName, 3, input, nil)
+		if err != nil {
+			t.Fatalf("complete successful lookup failed: %v", err)
+		}
+		if !reflect.DeepEqual(found, input) {
+			t.Fatalf("successful lookup changed shard metadata: got %#v, want %#v", found, input)
+		}
+		for i := range found {
+			if found[i].DB != input[i].DB {
+				t.Fatalf("successful lookup replaced database handle %d", i)
+			}
+		}
+	})
+}
