-	if len(openErrs) > 0 {
-		return nil, fmt.Errorf("table %s not found in opened message shards; %d/%d shards could not be opened, first error: %v", tableName, len(openErrs), len(shards), openErrs[0])
-	}
-	return nil, fmt.Errorf("table %s not found in %d message shards", tableName, len(shards))
+	if shardCount == 0 {
+		return nil, fmt.Errorf("no message shards are available")
+	}
+	// Every real shard was successfully opened and its schema checked. A chat
+	// without a local table (including unused filehelper) has no local history.
+	return nil, errMessageTableAbsent
