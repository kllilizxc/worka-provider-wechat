+package main
+
+import (
+	"path/filepath"
+	"testing"
+)
+
+func TestExplicitTalkerDoesNotRequireMetadataCache(t *testing.T) {
+	root := t.TempDir()
+	t.Setenv("WECHAT_CLI_CONFIG", filepath.Join(root, "missing-config.json"))
+	t.Setenv("WECHAT_CLI_STATE_DIR", filepath.Join(root, "missing-metadata"))
+	t.Setenv("WECHAT_CLI_DISABLE_AUTO_REFRESH", "1")
+	s := &server{}
+	for _, talker := range []string{"legacy_contact", "name.with-dash", "wxid_synthetic", "123@chatroom", "filehelper"} {
+		t.Run(talker, func(t *testing.T) {
+			got, err := s.resolveLooseChatArg(map[string]any{"talker": talker, "chat": "Display Name Must Not Be Resolved"})
+			if err != nil || got != talker {
+				t.Fatalf("explicit opaque ID was not preserved: got %q, error %v", got, err)
+			}
+		})
+	}
+	if _, err := s.resolveLooseChatArg(map[string]any{"talker": " ", "chat": "Display Name Requires Metadata"}); err == nil {
+		t.Fatal("display-name lookup failure was silently treated as an ID or empty history")
+	}
+}
