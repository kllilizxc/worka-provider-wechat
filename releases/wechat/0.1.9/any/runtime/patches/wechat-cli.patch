+func TestEmptyTimelineRetainsMessagesArray(t *testing.T) {
+	for _, tc := range []struct {
+		name     string
+		messages []map[string]any
+	}{
+		{name: "nil messages", messages: nil},
+		{name: "empty messages", messages: []map[string]any{}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			env := messageTimelineEnvelope(
+				map[string]any{"chat": "synthetic chat"}, nil, tc.messages,
+				messagePageInfo{Limit: 25}, "sort_seq DESC, local_id DESC", "asc",
+			)
+			messages, ok := env["messages"].([]map[string]any)
+			if !ok || messages == nil || len(messages) != 0 {
+				t.Fatalf("messages = %#v, want a present non-nil empty message slice", env["messages"])
+			}
+			query, ok := env["query"].(map[string]any)
+			if !ok || query["returned"] != 0 || query["has_more"] != false || query["limit"] != 25 {
+				t.Fatalf("empty timeline lost its standard pagination metadata: %#v", env["query"])
+			}
+			if freshness, ok := env["freshness"].(map[string]any); !ok || len(freshness) == 0 {
+				t.Fatalf("empty timeline lost freshness metadata: %#v", env["freshness"])
+			}
+			encoded, err := json.Marshal(env)
+			if err != nil {
+				t.Fatalf("encode timeline: %v", err)
+			}
+			var fields map[string]json.RawMessage
+			if err := json.Unmarshal(encoded, &fields); err != nil {
+				t.Fatalf("decode timeline JSON: %v", err)
+			}
+			if string(fields["messages"]) != "[]" {
+				t.Fatalf("messages JSON = %s, want []", fields["messages"])
+			}
+		})
+	}
+}
