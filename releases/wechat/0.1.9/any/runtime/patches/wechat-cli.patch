+//go:build darwin || linux
+
+package main
+
+import (
+	"context"
+	"github.com/r266-tech/wechat-cli/internal/config"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"syscall"
+	"testing"
+	"time"
+)
+
+func TestDefaultStatusDoesNotScanUnselectedDatabases(t *testing.T) {
+	if os.Getenv("WORKA_STATUS_TEST_CHILD") == "1" {
+		s := &server{cfg: &config.Config{Wxid: "synthetic", DBRoot: os.Getenv("WORKA_STATUS_TEST_ROOT"), Keys: map[string]string{"synthetic": "key"}}}
+		result := s.readOSStatus(false)
+		cache, _ := result["metadata_cache"].(map[string]any)
+		if _, present := cache["source_db_count"]; present {
+			t.Fatal("ordinary readiness must not inventory source files")
+		}
+		return
+	}
+	dir := t.TempDir()
+	storage := filepath.Join(dir, "db_storage", "unselected")
+	if err := os.MkdirAll(storage, 0700); err != nil {
+		t.Fatal(err)
+	}
+	// A source unavailable for reading must not block unrelated readiness checks.
+	if err := syscall.Mkfifo(filepath.Join(storage, "unavailable.db"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+	defer cancel()
+	cmd := exec.CommandContext(ctx, os.Args[0], "-test.run=^TestDefaultStatusDoesNotScanUnselectedDatabases$")
+	cmd.Env = append(os.Environ(), "WORKA_STATUS_TEST_CHILD=1", "WORKA_STATUS_TEST_ROOT="+dir, "WECHAT_CLI_CONFIG="+filepath.Join(dir, "config.json"), "WECHAT_CLI_STATE_DIR="+filepath.Join(dir, "state"), "WECHAT_CLI_WCDB_LIB="+filepath.Join(dir, "missing.dylib"))
+	if out, err := cmd.CombinedOutput(); err != nil {
+		t.Fatalf("ordinary readiness blocked on an unselected source: %v %s", err, out)
+	}
+}
