{
  "name": "@realiz3r/worka-provider-wechat",
  "version": "0.1.6",
  "private": true,
  "worka": {
    "dataVersion": 1
  },
  "type": "module",
  "description": "Shared local read-only WeChat provider for Worka",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./index.d.ts",
