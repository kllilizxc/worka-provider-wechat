+func TestBootstrapReusesDatabaseConfigWithoutImagePreparation(t *testing.T) {
+	cfg := wxcliConfig{DBRoot: "/synthetic/account", Keys: map[string]string{"synthetic-salt": "synthetic-key"}}
+	if !bootstrapCanReuseConfig(cfg, false) {
+		t.Fatal("ready text database configuration would prepare another shadow/login for an optional image key")
+	}
+	if bootstrapCanReuseConfig(cfg, true) {
+		t.Fatal("explicit image request was incorrectly treated as ready")
+	}
+	value := 7
+	cfg.ImageKey, cfg.ImageXORKey = "abcdefghijklmnop", &value
+	if !bootstrapCanReuseConfig(cfg, true) {
+		t.Fatal("existing image and database configuration was not reused")
+	}
+	cfg.Keys = nil
+	if bootstrapCanReuseConfig(cfg, false) {
+		t.Fatal("missing database keys were accepted")
+	}
