+func TestInspectCodecContextTriesAllDatabasesWithMatchingSalt(t *testing.T) {
+	f := newCodecFixture(t, true)
+	badPage := append([]byte(nil), f.dbs[0].Page1...)
+	badPage[4095] ^= 1
+	badDB := dbfiles.DB{
+		Path: "/synthetic/codec-context/corrupt.db", Rel: "message/corrupt.db",
+		Page1: badPage, Salt: badPage[:16],
+	}
+	f.dbs = append([]dbfiles.DB{badDB}, f.dbs...)
+	f.saltIdx[string(f.salt)] = []int{0, 1}
+	got, ok := inspectCodecContext(f.memory, codecFixtureAddress, f.dbs, f.saltIdx)
+	if !ok || got.DBPath != f.dbs[1].Path || got.KeyHex != hex.EncodeToString(f.key) {
+		t.Fatalf("did not select the authenticated database after a corrupt same-salt page: ok=%t result=%+v", ok, got)
+	}
+}
