+package main
+
+import (
+	"errors"
+	"testing"
+)
+
+func TestLaunchErrorDoesNotDiscardConfirmedPrivateProcess(t *testing.T) {
+	launchErr := errors.New("launch services timed out while permission was pending")
+	confirmed := false
+	pid, err := launchAndConfirmShadow(func() error { return launchErr }, func() (int, error) {
+		confirmed = true
+		return 123, nil
+	})
+	if !confirmed || err != nil || pid != 123 {
+		t.Fatalf("discarded launched process: %d %v", pid, err)
+	}
+}
+
+func TestUnconfirmedLaunchRetainsBothErrors(t *testing.T) {
+	launchErr, confirmErr := errors.New("launch error"), errors.New("no verified private process")
+	pid, err := launchAndConfirmShadow(func() error { return launchErr }, func() (int, error) { return 0, confirmErr })
+	if pid != 0 || !errors.Is(err, launchErr) || !errors.Is(err, confirmErr) {
+		t.Fatalf("lost actual startup failure: %d %v", pid, err)
+	}
+}
