+package scan
+
+import (
+	"bytes"
+	"crypto/hmac"
+	"crypto/pbkdf2"
+	"crypto/sha512"
+	"encoding/binary"
+	"encoding/hex"
+	"fmt"
+	"time"
+
+	"github.com/r266-tech/wxkey/internal/dbfiles"
+	"github.com/r266-tech/wxkey/internal/machvm"
+	"github.com/r266-tech/wxkey/internal/verify"
+)
+
+// SQLCipher 4.1 codec_ctx/cipher_ctx layout, checked against Tencent's source
+// and the actual arm64 client. Every pointer is independently allocated; keys
+// need not be adjacent to the salt. Reject incompatible layouts before reading
+// their pointers, and accept only a complete keyspec plus a verified page MAC.
+const codecContextSize = 136
+
+var codecFields = [...]uint32{256000, 2, 16, 32, 16, 16, 4096}
+var codecNeedle = func() []byte {
+	b := make([]byte, 4*len(codecFields))
+	for i, value := range codecFields {
+		binary.LittleEndian.PutUint32(b[i*4:], value)
+	}
+	return b
+}()
+
+type memoryReader interface {
+	Read(uint64, []byte) (int, error)
+}
+
+func readCodecBytes(reader memoryReader, address uint64, size int) ([]byte, bool) {
+	if address == 0 || address+uint64(size) < address {
+		return nil, false
+	}
+	b := make([]byte, size)
+	n, err := reader.Read(address, b)
+	return b, err == nil && n == size
+}
+
+func inspectCodecContext(reader memoryReader, address uint64, dbs []dbfiles.DB, saltIdx map[string][]int) (Result, bool) {
+	miss := Result{}
+	ctx, ok := readCodecBytes(reader, address, codecContextSize)
+	if !ok || !bytes.Equal(ctx[4:32], codecNeedle) {
+		return miss, false
+	}
+	u32 := func(offset int) uint32 { return binary.LittleEndian.Uint32(ctx[offset:]) }
+	u64 := func(offset int) uint64 { return binary.LittleEndian.Uint64(ctx[offset:]) }
+	if u32(0) > 1 || u32(56) > 1 || u32(32) != 99 || u32(36) != 80 || u32(40) != 64 || u32(44) != 0 ||
+		u32(48) != 2 || u32(52) != 2 || u32(60) != 0 || u32(64)&3 != 3 {
+		return miss, false
+	}
+	salt, ok := readCodecBytes(reader, u64(72), 16)
+	if !ok {
+		return miss, false
+	}
+	saltHex := hex.EncodeToString(salt)
+	indices := saltIdx[string(salt)]
+	if len(indices) == 0 {
+		return miss, false
+	}
+	macSalt, ok := readCodecBytes(reader, u64(80), 16)
+	if !ok {
+		return miss, false
+	}
+	for i := range salt {
+		if macSalt[i] != salt[i]^0x3a {
+			return miss, false
+		}
+	}
+	cipher, ok := readCodecBytes(reader, u64(104), 40)
+	if !ok || binary.LittleEndian.Uint32(cipher) != 0 {
+		return miss, false
+	}
+	pointer := func(offset int) uint64 { return binary.LittleEndian.Uint64(cipher[offset:]) }
+	key, ok := readCodecBytes(reader, pointer(8), 32)
+	if !ok {
+		return miss, false
+	}
+	macKey, ok := readCodecBytes(reader, pointer(16), 32)
+	if !ok {
+		return miss, false
+	}
+	keyspec, ok := readCodecBytes(reader, pointer(32), 99)
+	if !ok {
+		return miss, false
+	}
+
+	// Newer clients protect key, HMAC key and x'<key><salt>' with the same
+	// repeating 32-byte XOR. The known salt suffix spans exactly one period,
+	// so derive the encoding from the structure itself, not a version/mask
+	// table. An unprotected structure yields the all-zero mask naturally.
+	var mask [32]byte
+	for i := range mask {
+		mask[(66+i)%32] = keyspec[66+i] ^ saltHex[i]
+	}
+	for i := range key {
+		key[i] ^= mask[i]
+		macKey[i] ^= mask[i]
+	}
+	for i := range keyspec {
+		keyspec[i] ^= mask[i%32]
+	}
+	keyHex := hex.EncodeToString(key)
+	if string(keyspec) != "x'"+keyHex+saltHex+"'" {
+		return miss, false
+	}
+	derived, err := pbkdf2.Key(sha512.New, string(key), macSalt, 2, 32)
+	if err != nil || !hmac.Equal(derived, macKey) {
+		return miss, false
+	}
+	for _, index := range indices {
+		if index < 0 || index >= len(dbs) {
+			continue
+		}
+		db := dbs[index]
+		if !verify.VerifyAsEncKey(key, db.Page1) {
+			continue
+		}
+		return Result{DBRel: db.Rel, DBPath: db.Path, SaltHex: saltHex, KeyHex: keyHex, VerifyAs: "enc_key"}, true
+	}
+	return miss, false
+}
+
+type heapReader struct {
+	memoryReader
+	regions []memRegion
+}
+
+func (r heapReader) Read(address uint64, dst []byte) (int, error) {
+	for _, region := range r.regions {
+		if address >= region.addr && uint64(len(dst)) <= region.size && address-region.addr <= region.size-uint64(len(dst)) {
+			return r.memoryReader.Read(address, dst)
+		}
+	}
+	return 0, fmt.Errorf("codec pointer is outside readable heap")
+}
+
+func runCodecContextScan(pid int32, dbs []dbfiles.DB, saltIdx map[string][]int, opts Options, progress ProgressFn) (map[string]Result, Stats, error) {
+	start := time.Now()
+	results := map[string]Result{}
+	stats := Stats{}
+	finish := func(err error) (map[string]Result, Stats, error) {
+		stats.Found, stats.Elapsed = len(results), time.Since(start)
+		return results, stats, err
+	}
+	expired := func() bool { return !opts.Deadline.IsZero() && !time.Now().Before(opts.Deadline) }
+	if len(dbs) == 0 {
+		return finish(fmt.Errorf("scan.Run: no DBs to verify against"))
+	}
+	if expired() {
+		return finish(ErrDeadlineExceeded)
+	}
+	proc, err := machvm.Attach(pid)
+	if err != nil {
+		return finish(err)
+	}
+	defer proc.Detach()
+	var regions []memRegion
+	if err := proc.Regions(func(r machvm.Region) bool {
+		if isCodecHeapRegion(r) {
+			regions = append(regions, memRegion{r.Address, r.Size})
+		}
+		return !expired()
+	}); err != nil {
+		return finish(fmt.Errorf("enumerate regions: %w", err))
+	}
+	stats.Regions = len(regions)
+	reader := heapReader{proc, regions}
+	seen := map[uint64]struct{}{}
+	chunk := make([]byte, chunkSize+len(codecNeedle))
+	for _, region := range regions {
+		var carry []byte
+		for offset := uint64(0); offset < region.size; {
+			if expired() {
+				return finish(ErrDeadlineExceeded)
+			}
+			n := min(uint64(chunkSize), region.size-offset)
+			copy(chunk, carry)
+			read, err := proc.Read(region.addr+offset, chunk[len(carry):len(carry)+int(n)])
+			if err != nil || read == 0 {
+				stats.ReadFailures++
+				carry = nil
+				offset += n
+				continue
+			}
+			view := chunk[:len(carry)+read]
+			base := region.addr + offset - uint64(len(carry))
+			stats.BytesScanned += uint64(read)
+			for pos := 0; pos < len(view); {
+				found := bytes.Index(view[pos:], codecNeedle)
+				if found < 0 {
+					break
+				}
+				pos += found
+				address := base + uint64(pos) - 4
+				pos++
+				if expired() {
+					return finish(ErrDeadlineExceeded)
+				}
+				if address%8 != 0 {
+					continue
+				}
+				if _, exists := seen[address]; exists {
+					continue
+				}
+				seen[address] = struct{}{}
+				stats.CodecCandidates++
+				if result, ok := inspectCodecContext(reader, address, dbs, saltIdx); ok {
+					stats.VerifiedContexts++
+					rawSalt, _ := hex.DecodeString(result.SaltHex)
+					results[string(rawSalt)] = result
+					stats.Found = len(results)
+					if len(results) == len(saltIdx) {
+						return finish(nil)
+					}
+				}
+			}
+			carry = append(carry[:0], view[max(0, len(view)-len(codecNeedle)+1):]...)
+			offset += n
+			if progress != nil {
+				stats.Elapsed = time.Since(start)
+				progress(stats)
+			}
+		}
+	}
+	return finish(nil)
+}
+
+// macOS nano heaps are normally 512 MiB. A shared-cache size heuristic must
+// not exclude writable heaps; the scan already uses fixed-size chunks and a
+// deadline, and executable/readonly image mappings remain excluded.
+func isCodecHeapRegion(r machvm.Region) bool {
+	return r.IsReadable() && r.IsWritable() && !r.IsExecutable() && r.Size > 0
+}
