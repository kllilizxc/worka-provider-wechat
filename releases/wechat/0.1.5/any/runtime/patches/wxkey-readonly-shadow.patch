+func TestInspectCodecContextRejectsIncompleteReads(t *testing.T) {
+	allocations := []struct {
+		name    string
+		address uint64
+	}{
+		{"codec", codecFixtureAddress}, {"salt", codecFixtureSalt},
+		{"HMAC salt", codecFixtureMACSalt}, {"read context", codecFixtureRead},
+		{"key", codecFixtureKey}, {"HMAC key", codecFixtureMACKey},
+		{"keyspec", codecFixtureKeySpec},
+	}
+	for _, allocation := range allocations {
+		for _, faultName := range []string{"short read without error", "full read with error"} {
+			t.Run(allocation.name+"/"+faultName, func(t *testing.T) {
+				f := newCodecFixture(t, true)
+				fault := codecFixtureReadFault{short: true}
+				if faultName == "full read with error" {
+					fault = codecFixtureReadFault{err: errors.New("synthetic read failure")}
+				}
+				f.memory.faults[allocation.address] = fault
+				if _, ok := inspectCodecContext(f.memory, codecFixtureAddress, f.dbs, f.saltIdx); ok {
+					t.Fatal("incomplete or failed memory read was accepted")
+				}
+			})
+		}
+	}
+}
