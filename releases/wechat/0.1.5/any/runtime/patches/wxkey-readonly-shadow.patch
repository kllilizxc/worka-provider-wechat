+	"time"
+
+	"github.com/r266-tech/wxkey/internal/machvm"
+)
+
+// This exercises the real shadow signing function and the actual purego read
+// bindings across different executables. It never starts or reads WeChat.
+func TestReadOnlyPrivateShadowWithoutAdministrator(t *testing.T) {
+	if os.Geteuid() == 0 {
+		t.Skip("must exercise an ordinary user")
+	}
+	root := t.TempDir()
+	app := filepath.Join(root, "ReadOnlyProbe.app")
+	executable := filepath.Join(app, "Contents", "MacOS", "ReadOnlyProbe")
+	if err := os.MkdirAll(filepath.Dir(executable), 0o700); err != nil {
+		t.Fatal(err)
+	}
+	info := `<?xml version="1.0"?><plist version="1.0"><dict><key>CFBundleExecutable</key><string>ReadOnlyProbe</string><key>CFBundleIdentifier</key><string>org.worka.readonly-probe</string><key>CFBundlePackageType</key><string>APPL</string></dict></plist>`
+	if err := os.WriteFile(filepath.Join(app, "Contents", "Info.plist"), []byte(info), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	source := filepath.Join(root, "probe.c")
+	program := `#include <stdint.h>
+#include <stdio.h>
+#include <unistd.h>
+static const char marker[] = "Worka public cross-executable test";
+int main(void) {
+    printf("%u %llu\n", getuid(), (unsigned long long)(uintptr_t)marker);
+    fflush(stdout);
+    getchar();
+    return 0;
+}`
+	if err := os.WriteFile(source, []byte(program), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 20*time.Second)
+	defer cancel()
+	if out, err := exec.CommandContext(ctx, "/usr/bin/clang", "-O0", source, "-o", executable).CombinedOutput(); err != nil {
+		t.Fatalf("compile synthetic child: %v/%s", err, out)
+	}
+	if err := signShadowForReadAccess(app); err != nil {
+		t.Fatal(err)
+	}
+	if out, err := exec.CommandContext(ctx, "/usr/bin/codesign", "--verify", "--deep", "--strict", app).CombinedOutput(); err != nil {
+		t.Fatalf("verify synthetic signature: %v/%s", err, out)
+	}
+	child := exec.CommandContext(ctx, executable)
+	output, err := child.StdoutPipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	input, err := child.StdinPipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := child.Start(); err != nil {
+		t.Fatal(err)
+	}
+	defer func() { _ = input.Close(); _ = child.Wait() }()
+	line, err := bufio.NewReader(output).ReadString('\n')
+	if err != nil {
+		t.Fatalf("synthetic child startup: %v", err)
+	}
+	fields := strings.Fields(line)
+	if len(fields) != 2 {
+		t.Fatalf("invalid synthetic child handshake")
+	}
+	uid, err := strconv.Atoi(fields[0])
+	if err != nil || uid != os.Getuid() {
+		t.Fatalf("child not running as invoking user")
+	}
+	address, err := strconv.ParseUint(fields[1], 10, 64)
+	if err != nil {
+		t.Fatal(err)
+	}
+	process, err := machvm.Attach(int32(child.Process.Pid))
+	if err != nil {
+		t.Fatalf("read task port: %v", err)
+	}
+	defer process.Detach()
+	expected := "Worka public cross-executable test"
+	observed := make([]byte, len(expected))
+	n, err := process.Read(address, observed)
+	if err != nil || n != len(expected) || string(observed) != expected {
+		t.Fatalf("public synthetic read mismatch: bytes=%d err=%v", n, err)
+	}
+	regions := 0
+	if err := process.Regions(func(_ machvm.Region) bool { regions++; return regions < 3 }); err != nil {
+		t.Fatal(err)
+	}
+	if regions == 0 {
+		t.Fatal("read port could not enumerate any regions")
+	}
+	t.Log(fmt.Sprintf("ordinary uid=%d; cross-executable read and region enumeration passed", uid))
+}
