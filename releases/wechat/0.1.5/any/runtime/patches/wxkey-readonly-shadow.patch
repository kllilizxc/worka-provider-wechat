+package main
+
+import (
+	"os/exec"
+	"testing"
+	"time"
+	"unsafe"
+)
+
+func TestExitWaitToleratesDisappearingMetadataWithoutSignalling(t *testing.T) {
+	loadProcInfoFunctions()
+	if procInfoErr != nil {
+		t.Fatal(procInfoErr)
+	}
+	original := procPIDInfo
+	procPIDInfo = func(int32, int32, uint64, unsafe.Pointer, int32) int32 { return 0 }
+	defer func() { procPIDInfo = original }()
+
+	t.Run("reaped child is a completed exit", func(t *testing.T) {
+		child := exec.Command("/bin/sleep", "10")
+		if err := child.Start(); err != nil {
+			t.Fatal(err)
+		}
+		done := make(chan struct{})
+		go func() { time.Sleep(100 * time.Millisecond); _ = child.Process.Kill(); _ = child.Wait(); close(done) }()
+		defer func() { <-done }()
+		err := waitForWechatExit(wechatProcess{PID: child.Process.Pid}, "/unused.app", 2*time.Second)
+		if err != nil {
+			t.Fatalf("exit race rejected: %v", err)
+		}
+	})
+	t.Run("unknown live child remains alive", func(t *testing.T) {
+		child := exec.Command("/bin/sleep", "10")
+		if err := child.Start(); err != nil {
+			t.Fatal(err)
+		}
+		defer func() { _ = child.Process.Kill(); _ = child.Wait() }()
+		err := waitForWechatExit(wechatProcess{PID: child.Process.Pid}, "/unused.app", 50*time.Millisecond)
+		if err == nil {
+			t.Fatal("unknown live process was accepted as exited")
+		}
+		if !pidAlive(child.Process.Pid) {
+			t.Fatal("passive wait killed an unknown process")
+		}
+	})
+}
