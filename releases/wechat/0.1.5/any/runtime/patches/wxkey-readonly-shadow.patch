+		name   string
+		mutate func(*testing.T, *codecFixture)
+	}{
+		{"unknown salt", func(_ *testing.T, f *codecFixture) {
+			f.memory.blocks[codecFixtureSalt][0] ^= 0x80
+		}},
+		{"empty salt index", func(_ *testing.T, f *codecFixture) {
+			f.saltIdx = nil
+		}},
+		{"wrong HMAC salt", func(_ *testing.T, f *codecFixture) {
+			f.memory.blocks[codecFixtureMACSalt][0] ^= 0x80
+		}},
+		{"wrong stored HMAC key", func(_ *testing.T, f *codecFixture) {
+			f.memory.blocks[codecFixtureMACKey][0] ^= 0x80
+		}},
+		{"consistent keys for a different database", func(t *testing.T, f *codecFixture) {
+			wrong := append([]byte(nil), f.key...)
+			wrong[17] ^= 0x80
+			f.storeKeys(t, wrong)
+		}},
+		{"corrupt ciphertext", func(_ *testing.T, f *codecFixture) {
+			f.dbs[0].Page1[16] ^= 1
+		}},
+		{"corrupt IV", func(_ *testing.T, f *codecFixture) {
+			f.dbs[0].Page1[4016] ^= 1
+		}},
+		{"corrupt page HMAC", func(_ *testing.T, f *codecFixture) {
+			f.dbs[0].Page1[4095] ^= 1
+		}},
+		{"wrong page number", func(t *testing.T, f *codecFixture) {
+			codecFixtureSign(f.dbs[0].Page1, codecFixtureMAC(t, f.key, f.salt), []byte{2, 0, 0, 0})
+		}},
+		{"big endian page number", func(t *testing.T, f *codecFixture) {
