+func shadowStorageRoot(configPath string) (string, error) {
+	root := filepath.Join(filepath.Dir(configPath), "Library", "Application Support", "wx-mcp")
+	if selected := strings.TrimSpace(os.Getenv("WXKEY_SHADOW_WECHAT_APP")); selected != "" {
+		shared := filepath.Join(filepath.Dir(filepath.Dir(configPath)), "Library", "Application Support", "wx-mcp")
+		if selected == filepath.Join(root, "WeChat-shadow.app") {
+			return root, nil
+		}
+		if filepath.Base(filepath.Dir(filepath.Dir(configPath))) != ".wxkey-bootstrap" || selected != filepath.Join(shared, "WeChat-shadow.app") {
+			return "", fmt.Errorf("shadow path does not match private bootstrap storage")
+		}
+		root = shared
+	}
+	return root, nil
+}
