+package main
+
+import (
+	"path/filepath"
+	"testing"
+)
+
+func TestAccountRootUsesOpenedDatabaseInsteadOfSavedDirectory(t *testing.T) {
+	home := "/Users/public-fixture"
+	base := filepath.Join(home, "Library/Containers/com.tencent.xinWeChat/Data/Documents/xwechat_files")
+	active := filepath.Join(base, "active")
+	other := filepath.Join(base, "other")
+	for _, tc := range []struct {
+		name, output string
+		valid        bool
+	}{
+		{"login window without database", "p42\nn/Applications/WeChat.app/Contents/MacOS/WeChat\n", false},
+		{"one active account, multiple database files", "n" + active + "/db_storage/contact/contact.db\nn" + active + "/db_storage/message/message_0.db-wal\n", true},
+		{"multiple account roots are ambiguous", "n" + active + "/db_storage/contact/contact.db\nn" + other + "/db_storage/contact/contact.db\n", false},
+		{"another home cannot be selected", "n/Users/another/Library/Containers/com.tencent.xinWeChat/Data/Documents/xwechat_files/account/db_storage/contact/contact.db\n", false},
+		{"path traversal cannot escape container", "n" + active + "/../../../../../../outside/db_storage/contact.db\n", false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			got, err := accountRootFromOpenFiles(tc.output, home)
+			if tc.valid {
+				if err != nil || got != active {
+					t.Fatalf("active root not selected: %q/%v", got, err)
+				}
+			} else if err == nil {
+				t.Fatal("unready or ambiguous account was accepted")
+			}
+		})
+	}
+}
