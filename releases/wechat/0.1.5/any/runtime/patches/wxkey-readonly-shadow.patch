+package main
+
+import (
+	"context"
+	"fmt"
+	"os/exec"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"time"
+)
+
+// A saved account directory does not prove that this WeChat process is logged
+// in. Select only the database root actually opened by the verified process.
+func openedAccountRoot(pid int, home string) (string, error) {
+	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+	defer cancel()
+	out, err := exec.CommandContext(ctx, "/usr/sbin/lsof", "-a", "-p", strconv.Itoa(pid), "-Fn").Output()
+	if err != nil {
+		return "", fmt.Errorf("inspect opened WeChat database: %w", err)
+	}
+	return accountRootFromOpenFiles(string(out), home)
+}
+
+func accountRootFromOpenFiles(output, home string) (string, error) {
+	container := filepath.Join(home, "Library", "Containers", "com.tencent.xinWeChat", "Data")
+	roots := map[string]bool{}
+	for _, line := range strings.Split(output, "\n") {
+		if !strings.HasPrefix(line, "n/") {
+			continue
+		}
+		root, suffix, found := strings.Cut(line[1:], "/db_storage/")
+		if !found || suffix == "" {
+			continue
+		}
+		root = filepath.Clean(root)
+		rel, err := filepath.Rel(container, root)
+		if err != nil || rel == "." || rel == ".." || filepath.IsAbs(rel) || strings.HasPrefix(rel, ".."+string(filepath.Separator)) {
+			continue
+		}
+		roots[root] = true
+	}
+	if len(roots) != 1 {
+		return "", fmt.Errorf("expected one opened account database root, found %d", len(roots))
+	}
+	for root := range roots {
+		return root, nil
+	}
+	panic("unreachable")
+}
