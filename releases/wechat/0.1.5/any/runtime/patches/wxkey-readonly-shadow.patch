+package scan
+
+import (
+	"crypto/hmac"
+	"crypto/pbkdf2"
+	"crypto/sha512"
+	"encoding/binary"
+	"encoding/hex"
+	"errors"
+	"fmt"
+	"testing"
+	"time"
+
+	"github.com/r266-tech/wxkey/internal/dbfiles"
+	"github.com/r266-tech/wxkey/internal/machvm"
+)
+
+// Each synthetic allocation is more than 4 KiB from every other allocation.
+// A salt-neighborhood search cannot recover the key from this fixture.
+const (
+	codecFixtureAddress     uint64 = 0x100000
+	codecFixtureSalt        uint64 = 0x120000
+	codecFixtureMACSalt     uint64 = 0x140000
+	codecFixtureRead        uint64 = 0x160000
+	codecFixtureKey         uint64 = 0x180000
+	codecFixtureMACKey      uint64 = 0x1a0000
+	codecFixtureKeySpec     uint64 = 0x1c0000
+	codecFixtureBuffer      uint64 = 0x1e0000
+	codecFixtureBtree       uint64 = 0x200000
+	codecFixtureProvider    uint64 = 0x220000
+	codecFixtureProviderCtx uint64 = 0x240000
+)
+
+type codecFixtureReadFault struct {
+	short bool
+	err   error
+}
+
+// codecFixtureMemory only serves test-owned byte slices. It never attaches to
+// a process or opens the database paths carried in the result metadata.
+type codecFixtureMemory struct {
+	blocks map[uint64][]byte
+	faults map[uint64]codecFixtureReadFault
+}
+
+func (m *codecFixtureMemory) Read(address uint64, out []byte) (int, error) {
+	for base, block := range m.blocks {
+		if address < base || address-base >= uint64(len(block)) {
+			continue
+		}
+		fault := m.faults[base]
+		if fault.short && len(out) > 0 {
+			out = out[:len(out)-1]
+		}
+		n := copy(out, block[int(address-base):])
+		return n, fault.err
+	}
+	return 0, errors.New("unmapped synthetic address")
+}
+
+type codecFixture struct {
+	memory  *codecFixtureMemory
+	dbs     []dbfiles.DB
+	saltIdx map[string][]int
+	key     []byte
+	salt    []byte
+	mask    []byte
+}
+
+func newCodecFixture(t *testing.T, masked bool) *codecFixture {
+	t.Helper()
+	f := &codecFixture{
+		memory: &codecFixtureMemory{
+			blocks: make(map[uint64][]byte),
+			faults: make(map[uint64]codecFixtureReadFault),
+		},
+		key:  make([]byte, 32),
+		salt: make([]byte, 16),
+		mask: make([]byte, 32),
+	}
+	for i := range f.key {
+		f.key[i] = byte(i*29 + 11)
+		if masked {
+			f.mask[i] = byte(i*37 + 19)
+		}
+	}
+	// Real keys may contain NUL bytes; context validation must not use the
+	// heuristic filter applied to arbitrary binary password candidates.
+	f.key[0], f.key[1] = 0, 0
+	for i := range f.salt {
+		f.salt[i] = byte(i*13 + 49)
+	}
+	f.memory.blocks[codecFixtureSalt] = append([]byte(nil), f.salt...)
+	macSalt := make([]byte, 16)
+	for i, b := range f.salt {
+		macSalt[i] = b ^ 0x3a
+	}
+	f.memory.blocks[codecFixtureMACSalt] = macSalt
+
+	// The fixture encodes the documented SQLCipher 4.1 64-bit ABI directly,
+	// independently of the production parser's constants and helpers.
+	codec := make([]byte, 136)
+	fields := []uint32{0, 256000, 2, 16, 32, 16, 16, 4096, 99, 80, 64, 0, 2, 2, 0, 0, 3}
+	for i, value := range fields {
+		binary.LittleEndian.PutUint32(codec[i*4:], value)
+	}
+	pointers := []uint64{
+		codecFixtureSalt, codecFixtureMACSalt, codecFixtureBuffer,
+		codecFixtureBtree, codecFixtureRead, codecFixtureRead,
+		codecFixtureProvider, codecFixtureProviderCtx,
+	}
+	for i, pointer := range pointers {
+		binary.LittleEndian.PutUint64(codec[72+i*8:], pointer)
+	}
+	f.memory.blocks[codecFixtureAddress] = codec
+	read := make([]byte, 40)
+	binary.LittleEndian.PutUint64(read[8:], codecFixtureKey)
+	binary.LittleEndian.PutUint64(read[16:], codecFixtureMACKey)
+	binary.LittleEndian.PutUint64(read[32:], codecFixtureKeySpec)
+	f.memory.blocks[codecFixtureRead] = read
+	f.storeKeys(t, f.key)
+
+	page := make([]byte, 4096)
+	copy(page, f.salt)
+	for i := 16; i < 4032; i++ {
+		page[i] = byte(i*17 + 7)
+	}
+	macKey := codecFixtureMAC(t, f.key, f.salt)
+	codecFixtureSign(page, macKey, []byte{1, 0, 0, 0})
+	f.dbs = []dbfiles.DB{{
+		Path: "/synthetic/codec-context/message_0.db",
+		Rel:  "message/message_0.db", Page1: page, Salt: page[:16],
+	}}
+	f.saltIdx = map[string][]int{string(f.salt): {0}}
+	return f
+}
+
+func codecFixtureMAC(t *testing.T, key, salt []byte) []byte {
+	t.Helper()
+	macSalt := make([]byte, len(salt))
+	for i, b := range salt {
+		macSalt[i] = b ^ 0x3a
+	}
+	macKey, err := pbkdf2.Key(sha512.New, string(key), macSalt, 2, 32)
+	if err != nil {
+		t.Fatalf("derive synthetic HMAC key: %v", err)
+	}
+	return macKey
+}
+
+func codecFixtureSign(page, macKey, pageNumber []byte) {
+	mac := hmac.New(sha512.New, macKey)
+	mac.Write(page[16:4032])
+	mac.Write(pageNumber)
+	copy(page[4032:], mac.Sum(nil))
+}
+
+func (f *codecFixture) encode(data []byte) []byte {
+	out := make([]byte, len(data))
+	for i, b := range data {
+		out[i] = b ^ f.mask[i%32]
+	}
+	return out
+}
+
+func (f *codecFixture) storeKeys(t *testing.T, key []byte) {
+	t.Helper()
+	f.memory.blocks[codecFixtureKey] = f.encode(key)
+	f.memory.blocks[codecFixtureMACKey] = f.encode(codecFixtureMAC(t, key, f.salt))
+	spec := "x'" + hex.EncodeToString(key) + hex.EncodeToString(f.salt) + "'"
+	f.memory.blocks[codecFixtureKeySpec] = f.encode([]byte(spec))
+}
+
+func TestInspectCodecContextRecoversDispersedAllocations(t *testing.T) {
+	for _, masked := range []bool{false, true} {
+		t.Run(fmt.Sprintf("masked=%t", masked), func(t *testing.T) {
+			f := newCodecFixture(t, masked)
+			got, ok := inspectCodecContext(f.memory, codecFixtureAddress, f.dbs, f.saltIdx)
+			if !ok {
+				t.Fatal("valid dispersed codec context was rejected")
+			}
+			if got.KeyHex != hex.EncodeToString(f.key) {
+				t.Fatalf("KeyHex = %q, want recovered enc_key %q", got.KeyHex, hex.EncodeToString(f.key))
+			}
+			if got.SaltHex != hex.EncodeToString(f.salt) || got.DBRel != f.dbs[0].Rel || got.DBPath != f.dbs[0].Path {
+				t.Fatalf("result metadata does not identify the verified database: %+v", got)
+			}
+		})
+	}
+}
