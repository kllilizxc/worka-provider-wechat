+func TestRunWithOptionsExpiredDeadlineAvoidsProcessAccess(t *testing.T) {
+	f := newCodecFixture(t, true)
+	results, stats, err := RunWithOptions(-1, f.dbs, f.saltIdx, Options{
+		Deadline: time.Unix(1, 0),
+	}, func(Stats) {
+		t.Fatal("progress callback ran despite an already expired deadline")
+	})
+	if !errors.Is(err, ErrDeadlineExceeded) {
+		t.Fatalf("error = %v, want ErrDeadlineExceeded before attempting to attach to pid -1", err)
+	}
+	if len(results) != 0 || stats.Found != 0 || stats.Regions != 0 || stats.BytesScanned != 0 {
+		t.Fatalf("expired scan performed work: results=%d stats=%+v", len(results), stats)
+	}
+}
+
+func TestCodecScanIncludesMacOSNanoHeap(t *testing.T) {
+	nano := machvm.Region{Address: 0x100000, Size: 512 * 1024 * 1024, Protection: machvm.VM_PROT_READ | machvm.VM_PROT_WRITE}
+	if !isCodecHeapRegion(nano) {
+		t.Fatal("normal 512 MiB nano heap containing codec contexts was skipped")
+	}
+	for _, protection := range []int32{machvm.VM_PROT_READ, machvm.VM_PROT_READ | machvm.VM_PROT_WRITE | machvm.VM_PROT_EXECUTE} {
+		image := nano
+		image.Protection = protection
+		if isCodecHeapRegion(image) {
+			t.Fatal("image mapping selected as writable non-executable heap")
+		}
+	}
+	nano.Size = 0
+	if isCodecHeapRegion(nano) {
+		t.Fatal("empty region selected")
+	}
+}
