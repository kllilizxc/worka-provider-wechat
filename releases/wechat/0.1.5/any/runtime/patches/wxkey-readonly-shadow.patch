+func TestBootstrapForwardsExplicitImageRequestToSetup(t *testing.T) {
+	flags := scanFlags{pid: 123, root: "/synthetic/account", config: "/synthetic/config.json"}
+	want := []string{"/synthetic/wxkey", "setup", "--pid", "123", "--root", flags.root, "--config", flags.config}
+	if got := setupCommandArgs("/synthetic/wxkey", flags); !slices.Equal(got, want) {
+		t.Fatalf("text setup protocol changed: %v", got)
+	}
+	flags.imageKey = true
+	if got := setupCommandArgs("/synthetic/wxkey", flags); !slices.Equal(got, append(want, "--image-key")) {
+		t.Fatalf("explicit image request was lost at child setup boundary: %v", got)
+	}
+}
