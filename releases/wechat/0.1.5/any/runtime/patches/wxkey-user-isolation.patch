+	t.Setenv("WXKEY_ORIG_HOME", home)
+	previous := commandConfigPath
+	t.Cleanup(func() { commandConfigPath = previous })
+	config := filepath.Join(home, "providers", ".wxkey-bootstrap", "operation", "key_config.json")
+	f := parseFlags([]string{"--config", config})
+	shadow := filepath.Join(filepath.Dir(config), "Library", "Application Support", "wx-mcp", "WeChat-shadow.app")
+	t.Setenv("WXKEY_SHADOW_WECHAT_APP", filepath.Join(home, "unrelated.app"))
+	if f.config != config || shadowWeChatPath() != shadow || effectiveUserHome() != home {
+		t.Fatal("config-owned shadow changed the invoking home or accepted an unrelated shadow override")
+	}
+	if _, _, _, err := validateShadowWeChatPath(shadow); err != nil {
+		t.Fatalf("operation shadow rejected: %v", err)
+	}
+	if got, err := validateConfigPathForWrite(config, true); err != nil || got != config {
+		t.Fatalf("selected elevated config rejected: %q/%v", got, err)
+	}
+	if _, err := validateConfigPathForWrite(filepath.Join(home, "other.json"), true); err == nil {
+		t.Fatal("elevated command accepted a different config")
+	}
+	path, cleanup, err := createInvocationIdentityFile()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer cleanup()
+	identity, err := readInvocationIdentity(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if identity.ConfigPath != config || identity.Home != home || identity.UID != os.Getuid() {
+		t.Fatal("elevation record did not retain the same config and invoking identity")
+	}
+}
+
+func TestInvocationConfigRejectsEscapeAndSymlink(t *testing.T) {
+	home := t.TempDir()
+	outside := t.TempDir()
+	for _, path := range []string{"relative.json", filepath.Join(outside, "config.json"), home} {
+		if _, err := validateInvocationConfig(path, home); err == nil {
+			t.Fatalf("unsafe config accepted: %s", path)
+		}
+	}
+	if err := os.Symlink(outside, filepath.Join(home, "linked")); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := validateInvocationConfig(filepath.Join(home, "linked", "config.json"), home); err == nil {
+		t.Fatal("symlink config parent accepted")
+	}
+	target := filepath.Join(home, "target.json")
+	if err := os.WriteFile(target, []byte("sentinel"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	linked := filepath.Join(home, "linked.json")
+	if err := os.Symlink(target, linked); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := validateInvocationConfig(linked, home); err == nil {
+		t.Fatal("symlink config accepted")
+	}
+}
