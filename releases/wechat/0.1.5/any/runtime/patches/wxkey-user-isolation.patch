+	"time"
+	"unsafe"
+
+	"github.com/ebitengine/purego"
+)
+
+const invocationFileEnv = "WXKEY_INVOCATION_FILE"
+
+var failureCleanupMu sync.Mutex
+var failureCleanups []func()
+
+func registerFailureCleanup(cleanup func()) func() {
+	var once sync.Once
+	guarded := func() { once.Do(cleanup) }
+	failureCleanupMu.Lock()
+	failureCleanups = append(failureCleanups, guarded)
+	failureCleanupMu.Unlock()
+	return guarded
+}
+
+func runFailureCleanups() {
+	failureCleanupMu.Lock()
+	cleanups := append([]func(){}, failureCleanups...)
+	failureCleanups = nil
+	failureCleanupMu.Unlock()
+	for i := len(cleanups) - 1; i >= 0; i-- {
+		cleanups[i]()
+	}
+}
+
+type invocationIdentityRecord struct {
+	UID        int    `json:"uid"`
+	Username   string `json:"username"`
+	Home       string `json:"home"`
+	ConfigPath string `json:"configPath"`
+}
+
+type invocationIdentity struct {
+	UID        int
+	Username   string
+	Home       string
+	ConfigPath string
+}
+
+type wechatProcess struct {
+	PID   int
+	UID   int
+	RUID  int
+	Path  string
+	Start string
+}
+
+type procPIDInfoFunc func(pid int32, flavor int32, arg uint64, buffer unsafe.Pointer, bufferSize int32) int32
+type procPIDPathFunc func(pid int32, buffer unsafe.Pointer, bufferSize uint32) int32
+
+var procInfoOnce sync.Once
+var procPIDInfo procPIDInfoFunc
+var procPIDPath procPIDPathFunc
+var procInfoErr error
+
+func loadProcInfoFunctions() {
+	procInfoOnce.Do(func() {
+		lib, err := purego.Dlopen("/usr/lib/libproc.dylib", purego.RTLD_NOW|purego.RTLD_GLOBAL)
+		if err != nil {
+			procInfoErr = fmt.Errorf("load macOS libproc: %w", err)
+			return
+		}
+		purego.RegisterLibFunc(&procPIDInfo, lib, "proc_pidinfo")
+		purego.RegisterLibFunc(&procPIDPath, lib, "proc_pidpath")
+	})
+}
+
+func invokingIdentity() (invocationIdentity, error) {
+	if os.Geteuid() == 0 {
+		path := strings.TrimSpace(os.Getenv(invocationFileEnv))
+		if path == "" {
+			return invocationIdentity{}, fmt.Errorf("elevated wxkey has no verified invoking-user record")
+		}
+		return readInvocationIdentity(path)
+	}
+	if os.Geteuid() != os.Getuid() {
+		return invocationIdentity{}, fmt.Errorf("wxkey refuses an unexpected setuid identity")
+	}
+	entry, err := userpkg.LookupId(strconv.Itoa(os.Getuid()))
+	if err != nil {
+		return invocationIdentity{}, fmt.Errorf("resolve current user: %w", err)
+	}
+	home := entry.HomeDir
+	if override := strings.TrimSpace(os.Getenv("WXKEY_ORIG_HOME")); override != "" {
+		home = override
+	}
+	home, err = validateIdentityHome(home, os.Getuid())
+	if err != nil {
+		return invocationIdentity{}, err
+	}
+	configPath := commandConfigPath
+	if configPath == "" {
+		configPath = filepath.Join(home, ".config", "wxcli", "config.json")
+	}
+	configPath, err = validateInvocationConfig(configPath, home)
+	if err != nil {
+		return invocationIdentity{}, err
+	}
+	return invocationIdentity{UID: os.Getuid(), Username: entry.Username, Home: home, ConfigPath: configPath}, nil
+}
+
+func validateIdentityRecord(record invocationIdentityRecord, ownerUID int, lookup func(string) (*userpkg.User, error)) (invocationIdentity, error) {
+	if record.UID != ownerUID || ownerUID <= 0 {
+		return invocationIdentity{}, fmt.Errorf("invoking-user record UID does not match its file owner")
+	}
+	entry, err := lookup(strconv.Itoa(ownerUID))
+	if err != nil {
+		return invocationIdentity{}, fmt.Errorf("resolve invoking user: %w", err)
+	}
+	if record.Username != entry.Username {
+		return invocationIdentity{}, fmt.Errorf("invoking-user record username does not match its UID")
+	}
+	home, err := filepath.Abs(filepath.Clean(record.Home))
+	if err != nil {
+		return invocationIdentity{}, err
+	}
+	home, err = validateIdentityHome(home, ownerUID)
+	if err != nil {
+		return invocationIdentity{}, err
+	}
+	configPath, err := validateInvocationConfig(record.ConfigPath, home)
+	if err != nil {
+		return invocationIdentity{}, err
+	}
+	return invocationIdentity{UID: ownerUID, Username: entry.Username, Home: home, ConfigPath: configPath}, nil
+}
+
+// The selected config is the sole owner of bootstrap storage, including after
+// elevation. Its path must remain inside the verified user's home without links.
+func validateInvocationConfig(path, home string) (string, error) {
+	if !filepath.IsAbs(path) {
+		return "", fmt.Errorf("invoking command config must be absolute")
+	}
+	clean := filepath.Clean(path)
+	rel, err := filepath.Rel(home, clean)
+	if err != nil || rel == "." || filepath.IsAbs(rel) || rel == ".." || strings.HasPrefix(rel, ".."+string(os.PathSeparator)) {
+		return "", fmt.Errorf("invoking command config escapes invoking user's home")
+	}
+	root, err := os.OpenRoot(home)
+	if err != nil {
+		return "", err
+	}
+	defer root.Close()
+	if err := rejectRootSymlinkComponents(root, rel, true); err != nil {
+		return "", fmt.Errorf("unsafe invoking command config: %w", err)
+	}
+	return clean, nil
+}
+
+func validateIdentityHome(home string, uid int) (string, error) {
+	abs, err := filepath.Abs(filepath.Clean(home))
+	if err != nil || abs == string(os.PathSeparator) {
+		return "", fmt.Errorf("invalid invoking-user home")
+	}
+	info, err := os.Stat(abs)
+	if err != nil || !info.IsDir() {
+		return "", fmt.Errorf("invoking-user home is not an accessible directory")
+	}
+	st, ok := info.Sys().(*syscall.Stat_t)
+	if !ok || int(st.Uid) != uid {
+		return "", fmt.Errorf("invoking-user home is not owned by the invoking UID")
+	}
+	return abs, nil
+}
+
+func createInvocationIdentityFile() (string, func(), error) {
+	if os.Geteuid() == 0 || os.Geteuid() != os.Getuid() {
+		return "", nil, fmt.Errorf("cannot create an invoking-user record from this process identity")
+	}
+	identity, err := invokingIdentity()
+	if err != nil {
+		return "", nil, err
+	}
+	entry, err := userpkg.LookupId(strconv.Itoa(identity.UID))
+	if err != nil {
+		return "", nil, fmt.Errorf("resolve current user: %w", err)
+	}
+	dir, err := os.MkdirTemp("", "wxkey-invocation-")
+	if err != nil {
+		return "", nil, err
+	}
+	cleanup := func() { _ = os.RemoveAll(dir) }
+	if err := os.Chmod(dir, 0o700); err != nil {
+		cleanup()
+		return "", nil, err
+	}
+	path := filepath.Join(dir, "identity.json")
+	data, err := json.Marshal(invocationIdentityRecord{UID: identity.UID, Username: entry.Username, Home: identity.Home, ConfigPath: identity.ConfigPath})
+	if err != nil {
+		cleanup()
+		return "", nil, err
+	}
+	if err := os.WriteFile(path, append(data, '\n'), 0o600); err != nil {
+		cleanup()
+		return "", nil, err
+	}
+	return path, cleanup, nil
+}
+
+func readInvocationIdentity(path string) (invocationIdentity, error) {
+	path, err := filepath.Abs(filepath.Clean(path))
+	if err != nil {
+		return invocationIdentity{}, err
+	}
+	dir := filepath.Dir(path)
+	dirInfo, err := os.Lstat(dir)
+	if err != nil || !dirInfo.IsDir() || dirInfo.Mode()&os.ModeSymlink != 0 {
+		return invocationIdentity{}, fmt.Errorf("invoking-user record directory is missing or unsafe")
+	}
+	dirStat, ok := dirInfo.Sys().(*syscall.Stat_t)
+	if !ok || dirInfo.Mode().Perm() != 0o700 {
+		return invocationIdentity{}, fmt.Errorf("invoking-user record directory permissions are unsafe")
+	}
+	fileInfo, err := os.Lstat(path)
+	if err != nil || !fileInfo.Mode().IsRegular() || fileInfo.Mode()&os.ModeSymlink != 0 || fileInfo.Mode().Perm() != 0o600 {
+		return invocationIdentity{}, fmt.Errorf("invoking-user record file is missing or unsafe")
+	}
+	fileStat, ok := fileInfo.Sys().(*syscall.Stat_t)
+	if !ok || fileStat.Uid != dirStat.Uid {
+		return invocationIdentity{}, fmt.Errorf("invoking-user record ownership is inconsistent")
+	}
+	fd, err := syscall.Open(path, syscall.O_RDONLY|syscall.O_NOFOLLOW, 0)
+	if err != nil {
+		return invocationIdentity{}, err
+	}
+	f := os.NewFile(uintptr(fd), path)
+	defer f.Close()
+	opened, err := f.Stat()
+	if err != nil || !os.SameFile(fileInfo, opened) {
+		return invocationIdentity{}, fmt.Errorf("invoking-user record changed while opening")
+	}
+	var record invocationIdentityRecord
+	if err := json.NewDecoder(f).Decode(&record); err != nil {
+		return invocationIdentity{}, fmt.Errorf("parse invoking-user record: %w", err)
+	}
+	return validateIdentityRecord(record, int(fileStat.Uid), userpkg.LookupId)
+}
+
+func processSnapshot(pid int) (wechatProcess, error) {
+	if pid <= 0 {
+		return wechatProcess{}, fmt.Errorf("invalid WeChat PID")
+	}
+	loadProcInfoFunctions()
+	if procInfoErr != nil {
+		return wechatProcess{}, procInfoErr
+	}
+	const procPIDBSDInfo = 3
+	const procBSDInfoSize = 136
+	var info [procBSDInfoSize]byte
+	n := procPIDInfo(int32(pid), procPIDBSDInfo, 0, unsafe.Pointer(&info[0]), int32(len(info)))
+	if n != procBSDInfoSize || int(binary.LittleEndian.Uint32(info[12:16])) != pid {
+		return wechatProcess{}, fmt.Errorf("libproc could not verify WeChat PID %d", pid)
+	}
+	euid := int(binary.LittleEndian.Uint32(info[20:24]))
+	realUID := int(binary.LittleEndian.Uint32(info[28:32]))
+	start := fmt.Sprintf("%d.%06d", binary.LittleEndian.Uint64(info[120:128]), binary.LittleEndian.Uint64(info[128:136]))
+	var pathBuffer [4096]byte
+	pathLen := procPIDPath(int32(pid), unsafe.Pointer(&pathBuffer[0]), uint32(len(pathBuffer)))
+	if pathLen <= 0 || int(pathLen) >= len(pathBuffer) {
+		return wechatProcess{}, fmt.Errorf("libproc could not resolve executable path for WeChat PID %d", pid)
+	}
+	path := filepath.Clean(strings.TrimRight(string(pathBuffer[:pathLen]), "\x00"))
+	if !filepath.IsAbs(path) || path == "." || start == "0.000000" {
+		return wechatProcess{}, fmt.Errorf("WeChat PID %d has an unknown executable path or start time", pid)
+	}
+	return wechatProcess{PID: pid, UID: euid, RUID: realUID, Path: path, Start: start}, nil
+}
+
+func invokerWechatProcesses() ([]wechatProcess, invocationIdentity, error) {
+	identity, err := invokingIdentity()
+	if err != nil {
+		return nil, invocationIdentity{}, err
+	}
+	pids, err := wechatPIDs()
+	if err != nil {
+		return nil, invocationIdentity{}, fmt.Errorf("enumerate WeChat processes: %w", err)
+	}
+	processes := make([]wechatProcess, 0, len(pids))
+	for _, pid := range pids {
+		process, err := processSnapshot(pid)
+		if err != nil {
+			if !pidAlive(pid) {
+				continue
+			}
+			return nil, invocationIdentity{}, fmt.Errorf("cannot establish identity of WeChat PID %d: %w", pid, err)
+		}
+		processes = append(processes, process)
+	}
+	shadow, _, _, err := validateShadowWeChatPath(shadowWeChatPath())
+	if err != nil {
+		return nil, invocationIdentity{}, err
+	}
+	shadow = filepath.Clean(shadow)
+	processes, err = scopeWechatProcesses(processes, identity, wechatAppPath, shadow)
+	if err != nil {
+		return nil, invocationIdentity{}, err
+	}
+	return processes, identity, nil
+}
+
+func verifiedWechatPID(pid int) (wechatProcess, error) {
+	processes, _, err := invokerWechatProcesses()
+	if err != nil {
+		return wechatProcess{}, err
+	}
+	for _, process := range processes {
+		if process.PID == pid {
+			return process, nil
+		}
+	}
+	return wechatProcess{}, fmt.Errorf("WeChat PID %d is not a verified process for the invoking UID", pid)
+}
+
+func verifiedWechatProcessesUnderApp(appPath string) ([]wechatProcess, error) {
+	processes, _, err := invokerWechatProcesses()
+	if err != nil {
+		return nil, err
+	}
+	expected := expectedWechatExecutable(appPath)
+	filtered := make([]wechatProcess, 0, len(processes))
+	for _, process := range processes {
+		if process.Path == expected {
+			filtered = append(filtered, process)
+		} else {
+			return nil, fmt.Errorf("WeChat PID %d is running outside the selected app %s", process.PID, appPath)
+		}
+	}
+	return filtered, nil
+}
+
+func verifiedWechatProcessInSnapshot(process wechatProcess) bool {
+	current, err := processSnapshot(process.PID)
+	if err != nil || !sameProcessIdentity(process, current) {
+		return false
+	}
+	identity, err := invokingIdentity()
+	if err != nil || current.UID != identity.UID || current.RUID != identity.UID {
+		return false
+	}
+	return current.Path == expectedWechatExecutable(wechatAppPath) || current.Path == expectedWechatExecutable(shadowWeChatPath())
+}
+
+func expectedWechatExecutable(appPath string) string {
+	return filepath.Clean(filepath.Join(appPath, "Contents", "MacOS", "WeChat"))
+}
+
+func scopeWechatProcesses(processes []wechatProcess, identity invocationIdentity, originalApp, shadowApp string) ([]wechatProcess, error) {
+	var own []wechatProcess
+	originalExe := expectedWechatExecutable(originalApp)
+	shadowExe := expectedWechatExecutable(shadowApp)
+	for _, process := range processes {
+		if process.UID != identity.UID || process.RUID != identity.UID {
+			if process.UID == identity.UID || process.RUID == identity.UID {
+				return nil, fmt.Errorf("WeChat PID %d has mismatched real/effective UID; refusing process control", process.PID)
+			}
+			if pathInsideApp(process.Path, shadowApp) {
+				return nil, fmt.Errorf("another UID is using this user's shadow WeChat path; refusing to replace it")
+			}
+			continue
+		}
+		if process.Path != originalExe && process.Path != shadowExe {
+			return nil, fmt.Errorf("WeChat PID %d has an unrecognized executable path; refusing process control", process.PID)
+		}
+		own = append(own, process)
+	}
+	if len(own) > 1 {
+		return nil, fmt.Errorf("multiple WeChat processes belong to UID %d; close the extra instance and retry", identity.UID)
+	}
+	return own, nil
+}
+
+func sameProcessIdentity(before, current wechatProcess) bool {
+	return before.PID == current.PID && before.UID == current.UID && before.RUID == current.RUID && before.Path == current.Path && before.Start == current.Start
+}
+
+func validateProcessForSignal(before, current wechatProcess, identity invocationIdentity, targetApp string) error {
+	if before.UID != identity.UID || before.RUID != identity.UID {
+		return fmt.Errorf("refusing to signal a WeChat process outside the invoking UID")
+	}
+	if !sameProcessIdentity(before, current) {
+		return fmt.Errorf("WeChat PID %d changed identity or executable path; refusing to signal it", before.PID)
+	}
+	if current.Path != expectedWechatExecutable(targetApp) {
+		return fmt.Errorf("WeChat PID %d is outside the selected app; refusing to signal it", current.PID)
+	}
+	return nil
+}
+
+func signalVerifiedWechatProcess(process wechatProcess, targetApp string, sig syscall.Signal) error {
+	identity, err := invokingIdentity()
+	if err != nil {
+		return err
+	}
+	current, err := processSnapshot(process.PID)
+	if err != nil {
+		return fmt.Errorf("recheck WeChat PID %d before signal: %w", process.PID, err)
+	}
+	if err := validateProcessForSignal(process, current, identity, targetApp); err != nil {
+		return err
+	}
+	return syscall.Kill(process.PID, sig)
+}
+
+func waitForWechatExit(process wechatProcess, targetApp string, timeout time.Duration) error {
+	deadline := time.Now().Add(timeout)
+	for time.Now().Before(deadline) {
+		current, err := processSnapshot(process.PID)
+		if err != nil {
+			if !pidAlive(process.PID) {
+				return nil
+			}
+			return fmt.Errorf("cannot verify WeChat PID %d while waiting for exit: %w", process.PID, err)
+		}
+		identity, idErr := invokingIdentity()
+		if idErr != nil {
+			return idErr
+		}
+		if err := validateProcessForSignal(process, current, identity, targetApp); err != nil {
+			return err
+		}
+		time.Sleep(200 * time.Millisecond)
+	}
+	return fmt.Errorf("WeChat PID %d did not exit after SIGTERM; refusing to force-kill it", process.PID)
+}
